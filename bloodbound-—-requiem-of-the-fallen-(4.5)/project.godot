config_version=5

[application]

config/name="BLOODBOUND — REQUIEM OF THE FALLEN (4.5)"
config/use_custom_user_dir=true
config/custom_user_dir_name="Bloodbound"
run/main_scene="res://scenes/Throne.tscn"
config/features=PackedStringArray("4.5", "GL Compatibility")

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/size/window_width_override=1152
window/size/window_height_override=648
window/stretch/mode="canvas_items"

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
shader_cache/enabled=false
environment/defaults/default_clear_color=Color(0.031, 0.027, 0.052, 1)

[physics]

common/physics_ticks_per_second=60
